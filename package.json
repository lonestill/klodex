{
  "name": "klodex",
  "version": "0.1.0",
  "type": "module",
  "bin": {
    "klodex": "./bin/klodex.js"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/lonestill/klodex"
  },
  "scripts": {
    "build": "cd web-ui && bun run build",
    "start": "bun run src/index.ts",
    "dev": "bun run src/index.ts --watch",
    "dev:ui": "cd web-ui && bun run dev",
    "dev:all": "bun run src/index.ts --watch & cd web-ui && bun run dev"
  },
  "devDependencies": {
    "@types/bun": "latest"
  },
  "peerDependencies": {
    "typescript": "^7"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "^4.0.81",
    "@ai-sdk/google": "^4.0.98",
    "@ai-sdk/openai": "^4.0.95",
    "@ai-sdk/openai-compatible": "^3.0.70",
    "ai": "^7.0.142",
    "marked": "^18.1.1",
    "zod": "^4.6.7"
  }
}
