{
  "name": "klodex",
  "version": "0.1.23",
  "type": "module",
  "bin": {
    "klodex": "./bin/klodex.js"
  },
  "workspaces": [
    "web-ui"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/lonestill/klodex"
  },
  "scripts": {
    "test": "bun test",
    "browser:install": "bunx playwright install chromium",
    "build": "bun --filter web-ui build",
    "build:dmg": "bash scripts/build-dmg.sh",
    "install:all": "bun install && cd web-ui && bun install",
    "start": "bun run src/index.ts",
    "dev": "bun run src/index.ts --watch",
    "dev:ui": "cd web-ui && bun run dev",
    "dev:all": "bun run src/index.ts --watch & cd web-ui && bun run dev"
  },
  "devDependencies": {
    "@types/bun": "latest"
  },
  "peerDependencies": {
    "typescript": "^7"
  },
  "dependencies": {
    "playwright": "^1.56.1",
    "@ai-sdk/anthropic": "^4.0.81",
    "@ai-sdk/google": "^4.0.98",
    "@ai-sdk/openai": "^4.0.95",
    "@ai-sdk/openai-compatible": "^3.0.70",
    "ai": "^7.0.142",
    "marked": "^18.1.1",
    "zod": "^4.6.7"
  }
}
